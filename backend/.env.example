# Copier ce fichier en .env et remplir les vraies valeurs

# Connexion PostgreSQL
DATABASE_URL=postgresql://postgres:Postgres123@localhost:5432/quizapp_db

# Clé API pour la génération de quiz (Groq — gratuit, sans carte bancaire)
# À récupérer sur https://console.groq.com/keys
GROQ_API_KEY=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
# Optionnel : modèle à utiliser (par défaut openai/gpt-oss-120b)
# Liste des modèles disponibles : https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Nom de l'école (pour restreindre les inscriptions plus tard si besoin)
ECOLE_NOM=ENI Fianarantsoa

# Clé secrète pour protéger l'interface d'administration (élèves/matières)
# Change absolument cette valeur avant tout déploiement réel !
ADMIN_API_KEY=59fee3b0fc3d466d65bc9e50602cd23c7b82d049b2a8eaa4
